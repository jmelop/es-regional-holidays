{
  "name": "es-regional-holidays",
  "version": "0.1.0",
  "description": "A JavaScript/TypeScript library to get public holidays in Spain by region.",
  "author": "jmelop",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmelop/es-regional-holidays.git"
  },
  "bugs": {
    "url": "https://github.com/jmelop/es-regional-holidays/issues"
  },
  "homepage": "https://github.com/jmelop/es-regional-holidays#readme",
  "keywords": [
    "spain",
    "holidays",
    "public-holidays",
    "calendar",
    "boe",
    "regional-holidays",
    "autonomous-communities",
    "españa",
    "festivos",
    "calendario-laboral",
    "dias-no-laborables",
    "festivos-autonomicos"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.0.5"
  }
}